{
  "PostToolUse": [
    {
      "matcher": "^(write|edit|apply_patch|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "sh \"{hooks_dir}/after-edit\" edit"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "sh \"{hooks_dir}/after-edit\" finish"
        }
      ]
    }
  ]
}
