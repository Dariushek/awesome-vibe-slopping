#!/usr/bin/env python3
"""Run the project's validation commands for a stage: commit, push or all."""

import json
import subprocess
import sys
from pathlib import Path

CONFIG = Path(".agents") / "validation.json"
STAGES = ("commit", "push")


def repo_root():
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    )
    return Path(result.stdout.strip())


def main():
    stage = sys.argv[1] if len(sys.argv) > 1 else "all"
    if stage != "all" and stage not in STAGES:
        sys.exit(f"validate: unknown stage {stage}, use {', '.join(STAGES)} or all")

    root = repo_root()
    path = root / CONFIG
    if not path.is_file():
        print(f"validate: {CONFIG} missing, nothing checked", file=sys.stderr)
        return 0

    config = json.loads(path.read_text())
    for name in STAGES if stage == "all" else (stage,):
        for command in config.get(name, []):
            print(f"validate {name}: {command}", flush=True)
            if subprocess.run(command, shell=True, cwd=root).returncode != 0:
                print(f"validate: failed: {command}", file=sys.stderr)
                return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
