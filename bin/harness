#!/usr/bin/env python3
"""Render harness bundles from this repo into a project."""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from enum import Enum
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PLUGINS_DIR = REPO / "plugins"
MARKETPLACE_FILE = REPO / ".claude-plugin" / "marketplace.json"
README_FILE = REPO / "README.md"
MARKETPLACE_NAME = "awesome-vibe-slopping"
GITHUB_REPO = "Dariushek/awesome-vibe-slopping"

PLUGIN_MANIFEST = Path(".claude-plugin") / "plugin.json"
LOCK_FILE = ".harness.json"
AGENTS_FILE = "AGENTS.md"
CLAUDE_FILE = "CLAUDE.md"
CLAUDE_SETTINGS = Path(".claude") / "settings.json"
AGENTS_IMPORT = "@AGENTS.md"

BLOCK_BEGIN = "<!-- harness:begin"
BLOCK_BEGIN_LINE = f"{BLOCK_BEGIN} generated from {MARKETPLACE_NAME}, edit there -->"
BLOCK_END = "<!-- harness:end -->"

CONFIG_DIR = Path.home() / ".config" / MARKETPLACE_NAME
GLOBAL_LOCK = CONFIG_DIR / "global.json"
PROJECTS_FILE = CONFIG_DIR / "projects.json"

CLAUDE_KINDS = ("skills", "agents", "commands")
GIT_HOOKS_DIR = ".githooks"
AGENT_HOOKS_DIR = ".claude/hooks"
HOOKS_MANIFEST = "hooks.json"
BYTECODE_CACHE = "__pycache__"
PLUGIN_HOOKS_ROOT = "${CLAUDE_PLUGIN_ROOT}/hooks/"
PROJECT_HOOKS_ROOT = "$CLAUDE_PROJECT_DIR/.claude/hooks/"
# Devin CLI and Devin Desktop share one hook format. A bundle opts in with hooks/devin.json.
DEVIN_HOOKS_DIR = ".devin/hooks"
DEVIN_HOOKS_FILE = Path(".devin") / "hooks.v1.json"
DEVIN_MANIFEST = "devin.json"
DEVIN_HOOKS_PLACEHOLDER = "{hooks_dir}"
DEVIN_HOOKS_ROOT = "${DEVIN_PROJECT_DIR:-.}/" + DEVIN_HOOKS_DIR
HOOK_MANIFESTS = (HOOKS_MANIFEST, DEVIN_MANIFEST)
OVERRIDE_PATH = ".agents/overrides/{name}.md"
EXCLUSIVE_BUNDLES = [{"architecture", "architecture-light"}]
FRONTMATTER_FENCE = "---"
SKILL_REFERENCE = re.compile(r"\brs-[a-z0-9]+(?:-[a-z0-9]+)*\b")
DIRTY_SUFFIX = "-dirty"
ENCODING = "utf-8"


class Target(str, Enum):
    AGENTS = "agents"
    CLAUDE = "claude"
    CLAUDE_PLUGIN = "claude-plugin"
    DEVIN = "devin"


class Overwrite(Enum):
    KEEP_EDITED = 1
    FORCE = 2


class Notice(Enum):
    PRINT = 1
    QUIET = 2


class Run:
    """Set once from the command line. A dry run reports changes and writes nothing."""

    dry = False


DEFAULT_TARGETS = [Target.AGENTS, Target.CLAUDE, Target.DEVIN]


def bundle_names():
    manifests = PLUGINS_DIR.glob(f"*/{PLUGIN_MANIFEST}")
    return sorted(m.parent.parent.name for m in manifests)


def bundle_dir(name):
    path = PLUGINS_DIR / name
    if not (path / PLUGIN_MANIFEST).is_file():
        sys.exit(f"Unknown bundle: {name}. Available: {', '.join(bundle_names())}")

    return path


def sha(data):
    return hashlib.sha256(data).hexdigest()


def read_text(path):
    return path.read_text(encoding=ENCODING)


def put(path, data):
    """Write text or bytes. Returns whether the file changed."""
    if isinstance(data, str):
        data = data.encode(ENCODING)

    if path.is_file() and path.read_bytes() == data:
        return False

    if Run.dry:
        print(f"would write {path}")
        return True

    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data)
    return True


def remove(path):
    if not path.is_file():
        return

    if Run.dry:
        print(f"would remove {path}")
        return

    path.unlink()


def read_json(path):
    if not path.is_file():
        return {}

    try:
        return json.loads(read_text(path))
    except ValueError as error:
        sys.exit(f"{path}: invalid JSON: {error}")


def write_json(path, data):
    put(path, json.dumps(data, indent=2) + "\n")


def repo_commit():
    result = subprocess.run(
        ["git", "-C", str(REPO), "describe", "--always", "--dirty"],
        capture_output=True, text=True,
    )
    return result.stdout.strip() or None


def source_commit():
    commit = repo_commit()
    if commit and commit.endswith(DIRTY_SUFFIX):
        print(f"warning: {REPO} has uncommitted changes, recorded as {commit}")

    return commit


def frontmatter(path):
    lines = read_text(path).splitlines()
    if not lines or lines[0] != FRONTMATTER_FENCE:
        return {}

    fields = {}
    for line in lines[1:]:
        if line == FRONTMATTER_FENCE:
            return fields

        key, sep, value = line.partition(":")
        if not sep:
            continue

        fields[key.strip()] = value.strip()

    return {}


def manifest(name):
    return read_json(bundle_dir(name) / PLUGIN_MANIFEST)


def with_dependencies(bundles, provided, notice):
    """Bundles plus what they require, unless another install provides it."""
    result = list(bundles)
    for name in result:
        for dependency in manifest(name).get("dependencies", []):
            if dependency in result or dependency in provided:
                continue

            if notice is Notice.PRINT:
                print(f"add {dependency}: required by {name}")

            result.append(dependency)

    return result


def has_rules(name):
    return any((bundle_dir(name) / "rules").glob("*.md"))


def render_rules(bundles):
    parts = []
    for name in bundles:
        for rule in sorted((bundle_dir(name) / "rules").glob("*.md")):
            parts.append(read_text(rule).strip())

    return "\n\n".join(parts)


def add_tree(files, src, dest, skip=()):
    if not src.is_dir():
        return

    for path in sorted(src.rglob("*")):
        if not path.is_file() or path.name in skip or BYTECODE_CACHE in path.parts:
            continue

        rel = f"{dest}/{path.relative_to(src).as_posix()}"
        if rel in files:
            sys.exit(f"Two bundles provide {rel}")

        files[rel] = path.read_bytes()


def plan_files(bundles, targets, hook_bundles=None):
    """Files to write. Git hooks also come from `hook_bundles`, which a global install cannot deliver."""
    files = {}
    for name in hook_bundles or bundles:
        add_tree(files, bundle_dir(name) / "githooks", GIT_HOOKS_DIR)

    for name in bundles:
        root = bundle_dir(name)
        if Target.AGENTS in targets:
            add_tree(files, root / "skills", ".agents/skills")

        if Target.DEVIN in targets and (root / "hooks" / DEVIN_MANIFEST).is_file():
            add_tree(files, root / "hooks", DEVIN_HOOKS_DIR, skip=HOOK_MANIFESTS)

        if Target.CLAUDE not in targets:
            continue

        for kind in CLAUDE_KINDS:
            add_tree(files, root / kind, f".claude/{kind}")

        add_tree(files, root / "hooks", AGENT_HOOKS_DIR, skip=HOOK_MANIFESTS)

    return files


def known_agents():
    """Agents as (config dir, rules file, skills dir relative to home)."""
    home = Path.home()
    appdata = os.environ.get("APPDATA")
    devin = Path(appdata) / "devin" if appdata else home / ".config" / "devin"
    agents = [
        (home / ".claude", "CLAUDE.md", ".claude/skills"),
        (home / ".codex", "AGENTS.md", ".agents/skills"),
        (home / ".gemini", "GEMINI.md", None),
        (devin, "AGENTS.md", ".agents/skills"),
        (home / ".devin", "global_rules.md", ".agents/skills"),
    ]
    return agents


def global_agents():
    return [agent for agent in known_agents() if agent[0].is_dir()]


def plan_global_files(bundles):
    dests = {skills for _, _, skills in global_agents() if skills}

    claude = (Path.home() / ".claude").is_dir()

    files = {}
    for name in bundles:
        for dest in sorted(dests):
            add_tree(files, bundle_dir(name) / "skills", dest)

        if claude:
            add_tree(files, bundle_dir(name) / "agents", ".claude/agents")

    return files


def is_edited(path, digest):
    if not path.is_file():
        return False

    if digest is None:
        return True

    return sha(path.read_bytes()) != digest


def prune_dirs(project, path):
    parent = path.parent
    while parent != project and parent.is_dir() and not any(parent.iterdir()):
        parent.rmdir()
        parent = parent.parent


def is_hook(rel):
    return rel.startswith(f"{GIT_HOOKS_DIR}/")


def write_files(project, files, previous, policy):
    written = {}
    for rel, data in files.items():
        path = project / rel
        same = path.is_file() and path.read_bytes() == data
        if not same and policy is Overwrite.KEEP_EDITED and is_edited(path, previous.get(rel)):
            print(f"skip {rel}: changed since last sync, use --force")
            if rel in previous:
                written[rel] = previous[rel]
            continue

        put(path, data)
        if is_hook(rel) and path.is_file() and not Run.dry:
            path.chmod(0o755)
        written[rel] = sha(data)

    for rel in previous.keys() - files.keys():
        path = project / rel
        if policy is Overwrite.KEEP_EDITED and is_edited(path, previous[rel]):
            print(f"keep {rel}: no longer managed but changed since last sync")
            continue

        remove(path)
        if not Run.dry:
            prune_dirs(project, path)

    return written


def block_span(text):
    start = text.find(BLOCK_BEGIN)
    end = text.find(BLOCK_END)
    if start == -1 or end <= start:
        return None

    return start, end + len(BLOCK_END)


def read_block(path):
    text = read_text(path) if path.is_file() else ""
    span = block_span(text)
    if not span:
        return ""

    body = text[span[0]:span[1] - len(BLOCK_END)]
    return body.partition("\n")[2].strip()


def upsert_block(path, body):
    block = f"{BLOCK_BEGIN_LINE}\n{body}\n{BLOCK_END}"
    text = read_text(path) if path.is_file() else ""
    span = block_span(text)

    if not body:
        if span:
            put(path, (text[:span[0]].rstrip() + "\n" + text[span[1]:].lstrip("\n")).lstrip("\n"))
        return

    if span:
        text = text[:span[0]] + block + text[span[1]:]
    elif text.strip():
        text = f"{text.rstrip()}\n\n{block}\n"
    else:
        text = f"{block}\n"

    put(path, text)


def ensure_import(project):
    path = project / CLAUDE_FILE
    text = read_text(path) if path.is_file() else ""
    if any(line.strip() == AGENTS_IMPORT for line in text.splitlines()):
        return

    body = f"{AGENTS_IMPORT}\n\n{text}" if text.strip() else f"{AGENTS_IMPORT}\n"
    put(path, body)


def git_config(project, *args):
    return subprocess.run(
        ["git", "-C", str(project), "config", *args],
        capture_output=True, text=True,
    )


def point_hooks(project, files):
    wanted = any(is_hook(rel) for rel in files)
    if subprocess.run(["git", "-C", str(project), "rev-parse"], capture_output=True).returncode != 0:
        if wanted:
            print(f"skip hooks: {project} is not a git repository")
        return

    current = git_config(project, "--get", "core.hooksPath").stdout.strip()
    if wanted and not current:
        if not Run.dry:
            git_config(project, "core.hooksPath", GIT_HOOKS_DIR)
        print(f"{'Would set' if Run.dry else 'Set'} core.hooksPath to {GIT_HOOKS_DIR}")
    elif wanted and current != GIT_HOOKS_DIR:
        print(f"keep core.hooksPath {current}: hooks in {GIT_HOOKS_DIR} not active")
    elif not wanted and current == GIT_HOOKS_DIR and not (project / GIT_HOOKS_DIR).is_dir():
        git_config(project, "--unset", "core.hooksPath")
        print("Unset core.hooksPath")


def has_components(name):
    root = bundle_dir(name)
    kinds = (*CLAUDE_KINDS, "hooks")
    return any((root / kind).is_dir() for kind in kinds) or (root / ".mcp.json").is_file()


def enable_plugins(project, bundles):
    path = project / CLAUDE_SETTINGS
    settings = read_json(path)
    if not settings and not bundles:
        return

    marketplaces = settings.get("extraKnownMarketplaces", {})
    marketplaces.pop(MARKETPLACE_NAME, None)

    suffix = f"@{MARKETPLACE_NAME}"
    enabled = {k: v for k, v in settings.get("enabledPlugins", {}).items() if not k.endswith(suffix)}
    for name in bundles:
        if has_components(name):
            enabled[f"{name}{suffix}"] = True

    if bundles:
        marketplaces[MARKETPLACE_NAME] = {"source": {"source": "github", "repo": GITHUB_REPO}}

    for key, value in (("extraKnownMarketplaces", marketplaces), ("enabledPlugins", enabled)):
        settings[key] = value
        if not value:
            del settings[key]

    write_json(path, settings)


def agent_hook_scripts():
    paths = PLUGINS_DIR.glob("*/hooks/*")
    return {p.name for p in paths if p.is_file() and p.name not in HOOK_MANIFESTS}


def is_ours(hook, scripts, hooks_dir):
    command = hook.get("command", "")
    return any(f"/{hooks_dir}/{name}" in command for name in scripts)


def without_ours(groups, scripts, hooks_dir):
    kept = []
    for group in groups:
        hooks = [h for h in group.get("hooks", []) if not is_ours(h, scripts, hooks_dir)]
        if hooks:
            kept.append({**group, "hooks": hooks})

    return kept


def merged_hooks(existing, ours, hooks_dir):
    """The project's own hooks, followed by ours as they are now."""
    scripts = agent_hook_scripts()
    hooks = {}
    for event, groups in existing.items():
        kept = without_ours(groups, scripts, hooks_dir)
        if kept:
            hooks[event] = kept

    for added in ours:
        for event, groups in added.items():
            hooks.setdefault(event, []).extend(groups)

    return hooks


def bundle_agent_hooks(name):
    path = bundle_dir(name) / "hooks" / HOOKS_MANIFEST
    if not path.is_file():
        return {}

    text = read_text(path).replace(PLUGIN_HOOKS_ROOT, PROJECT_HOOKS_ROOT)
    return json.loads(text).get("hooks", {})


def set_agent_hooks(project, bundles):
    """Register the bundles' agent hooks in the project's settings, next to the project's own."""
    path = project / CLAUDE_SETTINGS
    settings = read_json(path)
    ours = [bundle_agent_hooks(name) for name in bundles]
    hooks = merged_hooks(settings.get("hooks", {}), ours, AGENT_HOOKS_DIR)
    settings["hooks"] = hooks
    if not hooks:
        del settings["hooks"]

    if settings:
        write_json(path, settings)
    else:
        remove(path)


def bundle_devin_hooks(name):
    path = bundle_dir(name) / "hooks" / DEVIN_MANIFEST
    if not path.is_file():
        return {}

    return json.loads(read_text(path).replace(DEVIN_HOOKS_PLACEHOLDER, DEVIN_HOOKS_ROOT))


def set_devin_hooks(project, bundles):
    """Register the bundles' hooks for Devin. Its hooks file holds the hooks and nothing else."""
    path = project / DEVIN_HOOKS_FILE
    ours = [bundle_devin_hooks(name) for name in bundles]
    hooks = merged_hooks(read_json(path), ours, DEVIN_HOOKS_DIR)
    if hooks:
        write_json(path, hooks)
        return

    remove(path)
    if path.parent.is_dir() and not any(path.parent.iterdir()) and not Run.dry:
        path.parent.rmdir()


def check_exclusive(bundles):
    for group in EXCLUSIVE_BUNDLES:
        if group <= set(bundles):
            sys.exit(f"Pick one of {', '.join(sorted(group))}")


def pick_bundles(requested, lock):
    bundles = requested or lock.get("bundles")
    if not bundles:
        sys.exit(f"No bundles given and none saved. Available: {', '.join(bundle_names())}")

    return bundles


def overwrite_policy(args):
    return Overwrite.FORCE if args.force else Overwrite.KEEP_EDITED


def pick_targets(requested, lock):
    raw = requested.split(",") if requested else lock.get("targets", DEFAULT_TARGETS)
    try:
        targets = [Target(t) for t in raw]
    except ValueError as error:
        sys.exit(f"{error}. Valid targets: {', '.join(t.value for t in Target)}")

    if Target.CLAUDE in targets and Target.CLAUDE_PLUGIN in targets:
        sys.exit("Pick one of claude and claude-plugin")

    return targets


def global_bundles():
    bundles = read_json(GLOBAL_LOCK).get("bundles", [])
    return with_dependencies(bundles, (), Notice.QUIET)


def registered_projects():
    return read_json(PROJECTS_FILE).get("projects", [])


def register(project, present):
    projects = [p for p in registered_projects() if p != str(project)]
    if present:
        projects.append(str(project))

    if projects != registered_projects():
        write_json(PROJECTS_FILE, {"projects": sorted(projects)})


def sync_project(project, requested_bundles, requested_targets, policy):
    lock_path = project / LOCK_FILE
    lock = read_json(lock_path)
    requested = pick_bundles(requested_bundles, lock)
    targets = pick_targets(requested_targets, lock)

    installed_globally = global_bundles()
    for name in requested:
        if name in installed_globally and has_rules(name):
            print(f"warning: {name} is installed globally, its rules will apply twice")

    bundles = with_dependencies(requested, installed_globally, Notice.PRINT)
    check_exclusive(bundles)

    upsert_block(project / AGENTS_FILE, render_rules(bundles))
    if Target.CLAUDE in targets or Target.CLAUDE_PLUGIN in targets:
        ensure_import(project)

    if Target.CLAUDE_PLUGIN in targets:
        enable_plugins(project, bundles)

    set_agent_hooks(project, bundles if Target.CLAUDE in targets else [])
    set_devin_hooks(project, bundles if Target.DEVIN in targets else [])
    everything = with_dependencies(requested, (), Notice.QUIET)
    files = write_files(project, plan_files(bundles, targets, everything), lock.get("files", {}), policy)
    point_hooks(project, files)
    write_json(lock_path, {
        "source": GITHUB_REPO,
        "commit": source_commit(),
        "bundles": requested,
        "targets": [t.value for t in targets],
        "files": files,
    })
    register(project, present=True)
    print(f"{'Would sync' if Run.dry else 'Synced'} {', '.join(bundles)} into {project}")


def cmd_sync(args):
    policy = overwrite_policy(args)
    if not args.all:
        if not args.project:
            sys.exit("Give a project or --all")

        project = Path(args.project).resolve()
        if not project.is_dir():
            sys.exit(f"Not a directory: {project}")

        sync_project(project, args.bundles, args.targets, policy)
        return

    if args.project:
        sys.exit("--all takes no project or bundles")

    for name in registered_projects():
        project = Path(name)
        if not (project / LOCK_FILE).is_file():
            print(f"forget {project}: no {LOCK_FILE}")
            register(project, present=False)
            continue

        sync_project(project, None, args.targets, policy)


def cmd_global(args):
    lock = read_json(GLOBAL_LOCK)
    requested = pick_bundles(args.bundles, lock)
    bundles = with_dependencies(requested, (), Notice.PRINT)
    check_exclusive(bundles)
    body = render_rules(bundles)
    agents = global_agents()
    if not agents:
        checked = "\n  ".join(str(agent_dir) for agent_dir, _, _ in known_agents())
        sys.exit(f"No agent found. Checked:\n  {checked}")

    for agent_dir, filename, _ in agents:
        upsert_block(agent_dir / filename, body)
        print(f"{'Would write' if Run.dry else 'Wrote'} {', '.join(bundles)} into {agent_dir / filename}")

    files = write_files(Path.home(), plan_global_files(bundles), lock.get("files", {}), overwrite_policy(args))
    for rel in sorted({str(Path(rel).parents[-3]) for rel in files}):
        print(f"{'Would install' if Run.dry else 'Installed'} into {Path.home() / rel}")

    write_json(GLOBAL_LOCK, {
        "source": GITHUB_REPO,
        "commit": source_commit(),
        "bundles": requested,
        "files": files,
    })


def remove_project(project, policy):
    lock_path = project / LOCK_FILE
    lock = read_json(lock_path)
    if not lock:
        sys.exit(f"Not synced: {project}")

    upsert_block(project / AGENTS_FILE, "")
    if Target.CLAUDE_PLUGIN.value in lock.get("targets", []):
        enable_plugins(project, [])

    set_agent_hooks(project, [])
    write_files(project, {}, lock.get("files", {}), policy)
    set_devin_hooks(project, [])
    point_hooks(project, {})
    remove(lock_path)
    register(project, present=False)
    print(f"{'Would remove' if Run.dry else 'Removed'} the harness from {project}")


def remove_global(policy):
    lock = read_json(GLOBAL_LOCK)
    if not lock:
        sys.exit("Nothing installed globally")

    for agent_dir, filename, _ in global_agents():
        upsert_block(agent_dir / filename, "")

    write_files(Path.home(), {}, lock.get("files", {}), policy)
    remove(GLOBAL_LOCK)
    print(f"{'Would remove' if Run.dry else 'Removed'} the global harness")


def cmd_remove(args):
    policy = overwrite_policy(args)
    if args.is_global == bool(args.project):
        sys.exit("Give a project or --global")

    if args.is_global:
        remove_global(policy)
        return

    remove_project(Path(args.project).resolve(), policy)


def print_status(title, root, lock, planned, rules_paths, rules):
    previous = lock.get("files", {})
    outdated = [str(path) for path in rules_paths if read_block(path) != rules]
    outdated += sorted(rel for rel, data in planned.items() if sha(data) != previous.get(rel))
    outdated += sorted(previous.keys() - planned.keys())
    edited = sorted(rel for rel, digest in previous.items() if is_edited(root / rel, digest))
    missing = sorted(rel for rel in previous if not (root / rel).is_file())

    print(title)
    print(f"  bundles: {', '.join(lock.get('bundles', []))}")
    print(f"  synced at {lock.get('commit')}, source now {repo_commit()}")
    for label, items in (("outdated", outdated), ("edited locally", edited), ("missing", missing)):
        for item in items:
            print(f"  {label}: {item}")

    if not outdated and not edited and not missing:
        print("  up to date")


def project_status(project):
    lock = read_json(project / LOCK_FILE)
    if not lock:
        print(f"{project}\n  not synced")
        return

    bundles = with_dependencies(lock.get("bundles", []), global_bundles(), Notice.QUIET)
    targets = pick_targets(None, lock)
    everything = with_dependencies(lock.get("bundles", []), (), Notice.QUIET)
    planned = plan_files(bundles, targets, everything)
    print_status(str(project), project, lock, planned, [project / AGENTS_FILE], render_rules(bundles))


def global_status():
    lock = read_json(GLOBAL_LOCK)
    if not lock:
        return

    bundles = global_bundles()
    rules_paths = [agent_dir / filename for agent_dir, filename, _ in global_agents()]
    print_status("global", Path.home(), lock, plan_global_files(bundles), rules_paths, render_rules(bundles))


def cmd_status(args):
    if args.project:
        project_status(Path(args.project).resolve())
        return

    global_status()
    for name in registered_projects():
        project_status(Path(name))


def cmd_list(_args):
    for name in bundle_names():
        print(f"{name:20} {manifest(name).get('description', '')}")


def check_named(path, expected, problems):
    fields = frontmatter(path)
    if fields.get("name") != expected:
        problems.append(f"{path}: frontmatter name must be {expected}")

    if not fields.get("description"):
        problems.append(f"{path}: frontmatter description missing")


def version_at_head(name):
    result = subprocess.run(
        ["git", "-C", str(REPO), "show", f"HEAD:plugins/{name}/{PLUGIN_MANIFEST.as_posix()}"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        return None

    try:
        return json.loads(result.stdout).get("version")
    except ValueError:
        return None


def has_uncommitted_changes(name):
    result = subprocess.run(
        ["git", "-C", str(REPO), "status", "--porcelain", "--", f"plugins/{name}"],
        capture_output=True, text=True,
    )
    return bool(result.stdout.strip())


def check_version(name, problems):
    committed = version_at_head(name)
    if committed is None or not has_uncommitted_changes(name):
        return

    if manifest(name).get("version") == committed:
        problems.append(f"plugins/{name}: changed since the last commit, bump version {committed}")


def check_references(root, known, problems):
    for path in sorted(root.rglob("*.md")):
        for reference in sorted(set(SKILL_REFERENCE.findall(read_text(path))) - known):
            problems.append(f"{path}: {reference} is no skill or agent")


def check_bundle(name, names, skills, agents, problems):
    root = PLUGINS_DIR / name
    dependencies = manifest(name).get("dependencies", [])
    if manifest(name).get("name") != name:
        problems.append(f"{root / PLUGIN_MANIFEST}: name must be {name}")

    for dependency in dependencies:
        if dependency not in names or dependency == name:
            problems.append(f"{root / PLUGIN_MANIFEST}: dependency {dependency} is no other bundle")

    for skill in sorted((root / "skills").glob("*/")):
        check_named(skill / "SKILL.md", skill.name, problems)
        if OVERRIDE_PATH.format(name=skill.name) not in read_text(skill / "SKILL.md"):
            problems.append(f"{skill / 'SKILL.md'}: must point to {OVERRIDE_PATH.format(name=skill.name)}")

    for agent in sorted((root / "agents").glob("*.md")):
        check_named(agent, agent.stem, problems)
        preloaded = frontmatter(agent).get("skills", "")
        for skill in (s.strip() for s in preloaded.split(",") if s.strip()):
            if skill not in skills:
                problems.append(f"{agent}: preloads unknown skill {skill}")

    for rule in sorted((root / "rules").glob("*.md")):
        if not read_text(rule).startswith("## "):
            problems.append(f"{rule}: must start with a ## heading")

    check_references(root, skills | agents, problems)
    check_version(name, problems)


def check_marketplace(names, problems):
    listed = {p["name"]: p for p in read_json(MARKETPLACE_FILE).get("plugins", [])}
    readme = read_text(README_FILE)
    for name in names:
        entry = listed.get(name, {})
        if entry.get("source") != f"./plugins/{name}":
            problems.append(f"{MARKETPLACE_FILE}: {name} missing or wrong source")
        elif entry.get("description") != manifest(name).get("description"):
            problems.append(f"{MARKETPLACE_FILE}: {name} description differs from its plugin.json")

        if f"`{name}`" not in readme:
            problems.append(f"{README_FILE}: {name} is not in the bundle table")

    for name in listed.keys() - set(names):
        problems.append(f"{MARKETPLACE_FILE}: {name} has no plugin directory")


def cmd_check(_args):
    problems = []
    names = bundle_names()
    skills = {p.parent.name for p in PLUGINS_DIR.glob("*/skills/*/SKILL.md")}
    agents = {p.stem for p in PLUGINS_DIR.glob("*/agents/*.md")}
    for name in names:
        check_bundle(name, names, skills, agents, problems)

    check_marketplace(names, problems)

    for problem in problems:
        print(problem)

    if problems:
        sys.exit(1)

    print("OK")


def add_write_flags(parser, force_help):
    parser.add_argument("--force", action="store_true", help=force_help)
    parser.add_argument("--dry-run", action="store_true", help="show what would change, write nothing")


def main(argv=None):
    parser = argparse.ArgumentParser(prog="harness", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("list", help="list bundles").set_defaults(func=cmd_list)
    sub.add_parser("check", help="validate this repo").set_defaults(func=cmd_check)

    sync = sub.add_parser("sync", help="render bundles into a project")
    sync.add_argument("project", nargs="?")
    sync.add_argument("bundles", nargs="*", help=f"defaults to bundles in {LOCK_FILE}")
    sync.add_argument("--all", action="store_true", help="resync every project synced from this machine")
    sync.add_argument("--targets", help="comma separated: agents, claude, claude-plugin, devin")
    add_write_flags(sync, "overwrite files changed in the project")
    sync.set_defaults(func=cmd_sync)

    glob = sub.add_parser("global", help="render bundle rules and skills into user-level agent config")
    glob.add_argument("bundles", nargs="*", help=f"defaults to bundles saved in {GLOBAL_LOCK}")
    add_write_flags(glob, "overwrite skills changed outside this repo")
    glob.set_defaults(func=cmd_global)

    status = sub.add_parser("status", help="show what is synced and what is out of date")
    status.add_argument("project", nargs="?", help="defaults to global and every synced project")
    status.set_defaults(func=cmd_status)

    rm = sub.add_parser("remove", help="remove the harness from a project or from user-level config")
    rm.add_argument("project", nargs="?")
    rm.add_argument("--global", dest="is_global", action="store_true", help="remove the global install")
    add_write_flags(rm, "also remove files changed since the last sync")
    rm.set_defaults(func=cmd_remove)

    args = parser.parse_args(argv)
    Run.dry = getattr(args, "dry_run", False)
    args.func(args)


if __name__ == "__main__":
    main()
