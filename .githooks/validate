#!/usr/bin/env python3
"""Run the project's validation commands for a stage: commit, push or all."""

import fnmatch
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

CONFIG = Path(".agents") / "validation.json"
STAGES = ("commit", "push")
STAMP_FILE = "harness-validated.json"
CHANGED = re.compile(r"\{changed(?::([^}]*))?\}")
CMD_VARIABLE = re.compile(r"%[^%]+%")
PYTHON = "{python}"
PUSH_BASES = ("@{upstream}", "origin/HEAD")
MAX_ARGUMENTS_LENGTH = 6000 if os.name == "nt" else 100000


def git(root, *args, env=None):
    return subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, env=env)


def repo_root():
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    )
    return Path(result.stdout.strip())


def tree_hash(root):
    """Tree of the working directory as it is now, untracked files included."""
    index = git(root, "rev-parse", "--git-path", "index").stdout.strip()
    with tempfile.TemporaryDirectory() as tmp:
        scratch = Path(tmp) / "index"
        if index and (root / index).is_file():
            shutil.copy(root / index, scratch)

        env = {**os.environ, "GIT_INDEX_FILE": str(scratch)}
        if git(root, "add", "-A", env=env).returncode != 0:
            return None

        result = git(root, "write-tree", env=env)
        return result.stdout.strip() if result.returncode == 0 else None


def fingerprint(root, commands):
    tree = tree_hash(root)
    if tree is None:
        return None

    return hashlib.sha256(f"{tree}\n{json.dumps(commands)}".encode()).hexdigest()


def stamp_path(root):
    path = git(root, "rev-parse", "--git-path", STAMP_FILE).stdout.strip()
    return root / path if path else None


def read_stamps(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, AttributeError):
        return {}


def file_list(root, *args):
    """Git prints paths as UTF-8 on every system, so never decode them with the locale's encoding."""
    result = subprocess.run(["git", *args, "-z"], cwd=root, capture_output=True)
    if result.returncode != 0:
        return None

    return [name for name in result.stdout.decode("utf-8", "surrogateescape").split("\0") if name]


def base_commit(root, name):
    """Commit the stage compares against, None when there is nothing to compare with."""
    if name == "commit":
        candidates = ("HEAD",)
    else:
        candidates = tuple(
            git(root, "merge-base", "HEAD", base).stdout.strip() for base in PUSH_BASES
        )

    for candidate in candidates:
        if candidate and git(root, "rev-parse", "--verify", "--quiet", f"{candidate}^{{commit}}").returncode == 0:
            return candidate

    return None


def changed_files(root, name):
    """Files of the working tree that differ from the stage's base, deleted ones left out."""
    untracked = file_list(root, "ls-files", "--others", "--exclude-standard") or []
    base = base_commit(root, name)
    tracked = file_list(root, "diff", "--name-only", "--diff-filter=d", base) if base else None
    if tracked is None:
        tracked = file_list(root, "ls-files", "--cached") or []

    return sorted(set(tracked) | set(untracked))


def matching(files, patterns):
    if not patterns:
        return files

    return [f for f in files if any(fnmatch.fnmatch(f, p.strip()) for p in patterns.split(","))]


def quote(files, windows=os.name == "nt"):
    """File names as shell arguments. cmd.exe takes `&` and friends literally only inside double quotes."""
    if windows:
        for name in files:
            if CMD_VARIABLE.search(name):
                sys.exit(f"validate: cmd.exe would expand a variable in the file name {name}, rename it")

        return " ".join(f'"{name}"' for name in files)

    return shlex.join(files)


def batches(files):
    batch, length = [], 0
    for name in files:
        if batch and length + len(name) > MAX_ARGUMENTS_LENGTH:
            yield batch
            batch, length = [], 0

        batch.append(name)
        length += len(name) + 3

    if batch:
        yield batch


def expand(command, files):
    """Command lines with the changed files filled in, none when a placeholder matches no file."""
    command = command.replace(PYTHON, quote([sys.executable]))
    placeholders = CHANGED.findall(command)
    if not placeholders:
        return [command]

    if any(not matching(files, patterns) for patterns in placeholders):
        return []

    if len(placeholders) == 1:
        return [
            CHANGED.sub(lambda _: quote(batch), command)
            for batch in batches(matching(files, placeholders[0]))
        ]

    return [CHANGED.sub(lambda match: quote(matching(files, match.group(1))), command)]


def run_stage(root, name, commands, stamps):
    if stamps.get(name) and stamps.get(name) == fingerprint(root, commands):
        print(f"validate {name}: passed on this tree already, skipped", flush=True)
        return True

    files = changed_files(root, name) if any(CHANGED.search(c) for c in commands) else []
    for command in commands:
        lines = expand(command, files)
        if not lines:
            print(f"validate {name}: no changed files, skipped: {command}", flush=True)

        for line in lines:
            print(f"validate {name}: {line}", flush=True)
            if subprocess.run(line, shell=True, cwd=root).returncode != 0:
                print(f"validate: failed: {command}", file=sys.stderr)
                return False

    stamps[name] = fingerprint(root, commands)
    return True


def load_config(path):
    try:
        config = json.loads(path.read_text(encoding="utf-8"))
    except ValueError as error:
        sys.exit(f"validate: {CONFIG}: invalid JSON: {error}")

    if not isinstance(config, dict):
        sys.exit(f"validate: {CONFIG}: must be an object")

    for name in STAGES:
        commands = config.get(name, [])
        if not isinstance(commands, list) or not all(isinstance(c, str) for c in commands):
            sys.exit(f"validate: {CONFIG}: {name} must be a list of command strings")

    return config


def main():
    # A console that cannot encode a file name must not stop the run.
    for stream in (sys.stdout, sys.stderr):
        stream.reconfigure(errors="backslashreplace")

    stage = sys.argv[1] if len(sys.argv) > 1 else "all"
    if stage != "all" and stage not in STAGES:
        sys.exit(f"validate: unknown stage {stage}, use {', '.join(STAGES)} or all")

    root = repo_root()
    path = root / CONFIG
    if not path.is_file():
        print(f"validate: {CONFIG} missing, nothing checked", file=sys.stderr)
        return 0

    config = load_config(path)
    stamp_file = stamp_path(root)
    stamps = read_stamps(stamp_file)
    for name in STAGES if stage == "all" else (stage,):
        commands = config.get(name, [])
        if not commands:
            continue

        passed = run_stage(root, name, commands, stamps)
        if stamp_file and stamps.get(name):
            stamp_file.write_text(json.dumps(stamps), encoding="utf-8")

        if not passed:
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
